{
  "name": "character-desktop",
  "productName": "Character Desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Offline desktop characters with local camera face capture",
  "main": "main.cjs",
  "scripts": {
    "start": "node scripts/start.cjs",
    "test": "node --test test/*.test.cjs",
    "package": "electron-packager . CharacterDesktop --platform=win32 --arch=x64 --out=dist --overwrite --asar \"--ignore=^/(dist|test|scripts)(/|$)\" \"--ignore=^/(README\\.md|start_desktop\\.bat|package_desktop\\.bat)$\""
  },
  "devDependencies": {
    "electron": "44.4.3",
    "@electron/packager": "20.3.0"
  }
}
